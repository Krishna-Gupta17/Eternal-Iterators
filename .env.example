# ---- LLM (optional). Leave LLM_API_KEY empty to run fully on the built-in parser. ----
# anthropic | openai | gemini | none
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional model override. Defaults: anthropic=claude-haiku-5-5, openai=gpt-4o-mini, gemini=gemini-2.0-flash
LLM_MODEL=
# Seconds before an LLM call is abandoned and the fallback parser is used
LLM_TIMEOUT_SECONDS=12

# ---- Auth ----
# Secret used to sign login tokens (use a long random string in production)
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# Password shared by all demo accounts
DEMO_PASSWORD=demo123

# ---- Export ----
# Team name written into schedule.json
TEAM_NAME=Eternal Iterators
